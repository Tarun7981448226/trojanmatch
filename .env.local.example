# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Neon) connection string. ./scripts/setup_db.sh fills this in.
DATABASE_URL=
# Random secret for signing session cookies (setup_db.sh generates one).
SESSION_SECRET=

# Gemini API key for the AI agents (aistudio.google.com/apikey). ./scripts/set_gemini.sh
GEMINI_API_KEY=

# Gmail address + app password for password-reset emails (optional). ./scripts/set_mail.sh
SMTP_USER=
SMTP_PASS=

# Google sign-in (optional): OAuth Web client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
